{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenLoop",
  "version": "0.1.19",
  "identifier": "com.devcom.screenloop",
  "mainBinaryName": "ScreenLoop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScreenLoop",
        "width": 960,
        "height": 700,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "**/recordings/**",
          "**/shots/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "macOS": { "entitlements": "Entitlements.plist" },
    "externalBin": [
      "binaries/ffmpeg"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGRDA3NzgwMUREOUUxNDMKUldSRDRka2RnSGZRcjJPUnhBRHNMQmdiaDFYcyszc3ZYNTFpU1lsM29iTENuc25MVTJiYXhTMmIK",
      "endpoints": [
        "https://github.com/Dimagithub/screenloop-desktop/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "screenloop"
        ]
      }
    }
  }
}